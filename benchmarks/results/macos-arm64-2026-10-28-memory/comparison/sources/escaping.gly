make x:int>[int] = fill(64, x)
work x:int>int
  a := make(x)
  b := a
  a[0] += 1
  ret sum(b)
main>void
  setup := clock()
  n := argi(0)
  setup = clock() - setup
  start := clock()
  total := 0
  i := 0
  while i < n
    total += work(i)
    i += 1
  elapsed := clock() - start
  print(total)
  print(setup)
  print(elapsed)
