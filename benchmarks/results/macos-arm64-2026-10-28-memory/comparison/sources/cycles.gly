type Node
  links:[Node]
  value:int
work seed:int>int
  i := 0
  total := 0
  while i < 64
    a := [Node([], seed)]
    b := [Node(a, i)]
    a[0].links = b
    total += a[0].links[0].links[0].value
    i += 1
  ret total
main>void
  setup := clock()
  n := argi(0)
  setup = clock() - setup
  start := clock()
  total := 0
  i := 0
  while i < n
    total += work(i)
    i += 1
  elapsed := clock() - start
  print(total)
  print(setup)
  print(elapsed)
