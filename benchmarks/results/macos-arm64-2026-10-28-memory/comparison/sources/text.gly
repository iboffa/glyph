work seed:int>int
  s := str_i64(seed)
  i := 0
  while i < 64
    s = concat(s, "abcdefghijklmnop")
    i += 1
  ret len(s) + byte_at(s, len(s) - 1)
main>void
  setup := clock()
  n := argi(0)
  setup = clock() - setup
  start := clock()
  total := 0
  i := 0
  while i < n
    total += work(i)
    i += 1
  elapsed := clock() - start
  print(total)
  print(setup)
  print(elapsed)
