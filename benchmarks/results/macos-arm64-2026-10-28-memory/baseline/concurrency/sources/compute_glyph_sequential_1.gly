transform x:int>int
  value := x + 1
  i := 0
  while i < 64
    value = (value * 48271) % 2147483647
    i += 1
  ret value
sequential a:[int]>[int]
  out := fill(len(a), 0)
  i := 0
  while i < len(a)
    out[i] = transform(a[i])
    i += 1
  ret out
main>void
  n := argi(0)
  repeats := argi(1)
  input := range(n)
  first := clock()
  output := sequential(input)
  first = clock() - first
  start := clock()
  r := 0
  while r < repeats
    input[0] = r
    output = sequential(input)
    r += 1
  elapsed := clock() - start
  print(sum(output))
  print(first)
  print(elapsed)
