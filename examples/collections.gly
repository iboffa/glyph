main>void
  numbers := list([1, 2, 3])
  numbers.append(4)
  numbers.set(0, 10)
  print(numbers.pop())
  for n:numbers.to_array()
    print(n)
  scores:map[str,int] = map([], [])
  scores.put("Ada", 42)
  scores.put("Grace", 99)
  print(scores.get("Ada"))
  print(scores.get_or("missing", 0))
  print(scores.contains("Grace"))
  names := set(["Ada", "Grace", "Ada"])
  print(len(names))
  print(names.add("Linus"))
  print(names.remove("Ada"))
