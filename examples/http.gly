# Pass an HTTP or HTTPS URL as the first argument.
main>void
  response := try_http_request("GET", arg(0), ["Accept: application/json"], [], 5000, 1048576, "")
  if not response.ok
    eprint(response.message)
    exit(1)
  print(response.status)
  text := try_decode_utf8(response.value)
  if not text.ok
    eprint(text.message)
    exit(1)
  print(text.value)
